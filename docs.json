{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Puffin Pay",
  "description": "Accept stablecoin payments on every major chain — by MacLeod Technologies",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "logo": {
    "light": "/logo/logo.svg",
    "dark": "/logo/logo-dark.svg",
    "href": "https://puffinmoney.com"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      { "language": "en", "default": true },
      { "language": "es" },
      { "language": "fr" },
      { "language": "pt" },
      { "language": "zh" },
      { "language": "hi" },
      { "language": "ar" }
    ],
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          { "group": "Getting started", "pages": ["introduction", "quickstart"] },
          { "group": "Ways to accept payments", "pages": ["payment-links", "hosted-checkout", "embed"] },
          { "group": "Wallet-as-a-Service", "pages": ["wallets", "bridging", "settlement"] },
          { "group": "Going further", "pages": ["webhooks", "teams-and-plans"] }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          { "group": "API", "pages": ["api/authentication", "api/payment-intents", "api/wallets", "api/bridge"] }
        ]
      }
    ]
  },
  "footer": {
    "socials": { "website": "https://macleodtechnologies.org" }
  }
}
